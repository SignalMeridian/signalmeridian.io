---
interface Props {
  class?: string;
}
const { class: cls = 'h-7 w-auto' } = Astro.props;
---

<a href="/" class={`inline-flex items-center gap-2.5 group ${cls}`} aria-label="Signal Meridian home">
  <img
    src="https://imagedelivery.net/9i0Mt_dC7lopRIG36ZQvKw/Signal-Meridian-logo-logo-1-2026-06-09-132622340Z-cb964339/public"
    alt=""
    aria-hidden="true"
    class="h-7 w-7 transition-transform duration-500 group-hover:rotate-[8deg]"
  />
  <img
    src="https://imagedelivery.net/9i0Mt_dC7lopRIG36ZQvKw/Signal-Meridian-namelogo-2-2026-06-09-132623796Z-9129b3f6/public"
    alt="Signal Meridian"
    class="h-[16px] w-auto"
  />
</a>
